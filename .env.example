# COLORJET Bangladesh ERP - Production Environment Template
# Copy this file to .env and fill with real production values
# This file is for documentation only - DO NOT commit real secrets to version control

# ============= FIREBASE CONFIGURATION =============
# Required: Must be present in google-services.json for production build
# Download from Firebase Console: https://console.firebase.google.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ============= BACKEND API CONFIGURATION =============
# Production VPS Backend Settings
# Must use HTTPS in production
COLORJET_API_BASE_URL=https://api.colorjetbd.com/erp
COLORJET_API_TOKEN=your-secure-backend-token-here
COLORJET_API_TIMEOUT_SECONDS=30

# ============= DATABASE CONFIGURATION =============
# Backend Database (MySQL or SQLite)
# For production: Use managed MySQL with encrypted connections
DB_PROVIDER=mysql
DB_HOST=your-secure-db-host.com
DB_PORT=3306
DB_NAME=colorjet_erp_production
DB_USER=colorjet_secure_user
DB_PASS=your-strong-secure-db-password-here
DB_CHARSET=utf8mb4

# ============= GEMINI AI CONFIGURATION =============
# Google Gemini API for AI Draft Center
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ============= SECURITY SETTINGS =============
# Allow CLI execution of migrations (set to false in production)
ALLOW_CLI_EXECUTION=false

# Restrict API to localhost only (set to true in production)
RESTRICT_TO_LOCALHOST=true

# ============= BUILD METADATA =============
# Application package and version
APP_PACKAGE_NAME=com.aistudio.colorjeterp.pxlmjq
APP_VERSION_CODE=23
APP_VERSION_NAME=1.0.23

# ============= LOGGING & MONITORING =============
# Enable detailed logging (false for production)
DEBUG_MODE=false

# Crash reporting endpoint
CRASH_REPORT_URL=https://api.colorjetbd.com/erp/crashes

# ============= PRODUCTION CHECKLIST =============
# Before deploying to production:
# 1. [ ] Fill all required values (don't leave placeholders)
# 2. [ ] Never commit .env file to git (only .env.example)
# 3. [ ] Ensure ALLOW_CLI_EXECUTION=false
# 4. [ ] Ensure DEBUG_MODE=false
# 5. [ ] Use strong, unique passwords for DB_PASS
# 6. [ ] Use HTTPS for all API URLs
# 7. [ ] Verify Firebase config is downloaded and placed correctly
# 8. [ ] Run: ./gradlew clean assembleRelease
# 9. [ ] Test on staging server first
# 10. [ ] Validate all role permissions work correctly
